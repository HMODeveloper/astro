---
interface Props {
  id?: string
}
const { id } = Astro.props
---

<section class="h1-container" data-section>
  <h1 id={id} data-scroll>
    <slot />
  </h1>
</section>

<style>
  .h1-container {
    position: relative;
    width: 100%;
    padding: 0;
    margin: var(--padding-y) 0;
  }
  .h1-container::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background-color: var(--text);
  }
  h1 {
    width: 100%;
    margin-bottom: 1rem;
    color: var(--text-light);
    transform: translateX(5%);
    opacity: 0;
    transition: all 0.3s ease;
  }
  h1[data-scroll].scrolled {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 640px) {
    h1::before {
      display: none;
    }
  }
</style>
