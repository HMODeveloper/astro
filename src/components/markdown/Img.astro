---
import LazyImage from "@/components/base/LazyImage.astro"

interface Props {
  src: string
  alt?: string
  width?: string | number
  height?: string | number
}
const { src, alt = "", width, height } = Astro.props
---

<LazyImage src={src} alt={alt} width={width} height={height} class="img" />

<style>
  .img {
    margin: var(--padding-y) 0;
  }
</style>
