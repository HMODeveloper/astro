---
interface Props {
  classname?: string
  card?: boolean
}
const { classname = "", card = false } = Astro.props
const classes = ["section"]
if (card) classes.push("card")
if (classname) classes.push(classname)
---

<section class:list={classes} data-section>
  {
    Astro.slots.has("title") && (
      <div class="title">
        <span data-scroll>
          <slot name="title" />
        </span>
      </div>
    )
  }
  <slot />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
  }
  .title {
    position: relative;
    width: 100%;
    padding: 0;
  }
  .title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background-color: var(--text);
  }
  .title > span[data-scroll] {
    width: 100%;
    margin-bottom: 1rem;
    color: var(--text-light);
    font-size: var(--title-size);
    transform: translateX(5%);
    opacity: 0;
    transition: all 0.3s ease;
    display: block;
  }
  .title > span[data-scroll].scrolled {
    transform: translateX(0);
    opacity: 1;
  }

  @media (min-width: 768px) {
    .section.card:hover {
      background-color: var(--bg-light);
    }
  }
</style>
