---
import { getCollection } from "astro:content"
import Section from "@/components/base/Section.astro"
import Desktop from "./Desktop.astro"
import Tablet from "./Tablet.astro"

const [site] = await getCollection("site")
---

<Section classname="hero-container">
  <Desktop hero={site.data.hero.title} sublines={site.data.hero.sublines} />
  <Tablet hero={site.data.hero.title} sublines={site.data.hero.sublines} />
</Section>

<style>
  .hero-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
