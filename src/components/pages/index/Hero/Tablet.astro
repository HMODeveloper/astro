---
interface Props {
  hero: string
  sublines: string[]
}

const { hero, sublines } = Astro.props
---

<div class="hero" data-responsive-tablet>
  <img src="/images/cover.webp" alt="cover" class="bg" />
  <div class="content">
    <div class="title" data-scroll>{hero}</div>
    <div class="subline" data-scroll>
      {sublines.map(line => <p>{line}</p>)}
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
  }
  .bg {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .content {
    width: 100%;
    margin-top: var(--padding-y);
    padding: var(--padding-y);
    text-align: center;
  }
  .title {
    font-size: var(--title-size);
    font-weight: bold;
    color: var(--text-light);
    transform: translateY(100%);
    opacity: 0;
    transition: 1s all ease;
  }
  .subline {
    font-size: var(--title-size);
    margin-top: var(--padding-y);
    cursor: pointer;
    transform: translateY(100%);
    opacity: 0;
    transition: 1.2s all ease;
  }
  .title[data-scroll].scrolled,
  .subline[data-scroll].scrolled {
    transform: translateY(0);
    opacity: 1;
  }
</style>
