---
import { getCollection } from "astro:content"
import Desktop from "./Desktop.astro"
import Tablet from "./Tablet.astro"

const entries = await getCollection("dynamic")
  .then(arr => arr
    .slice()
    .sort((a, b) => {
      const cmp = b.data.date.localeCompare(a.data.date)
      return cmp !== 0 ? cmp : b.data.index - a.data.index
    }),
  )

const items = entries.slice(0, 5).map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  cover: entry.data.cover,
  path: entry.id,
}))
---

<Desktop items={items} />
<Tablet items={items} />

<script>
  import { setupCarousel } from "@/scripts/carousel"

  const mq = window.matchMedia("(min-width: 769px)")
  let teardown: () => void = () => {}

  function init() {
    teardown()

    const isDesktop = mq.matches
    const rootSelector = isDesktop
      ? "[data-carousel-dynamic-desktop]"
      : "[data-carousel-dynamic-tablet]"
    const coverSelector = isDesktop ? ".cover" : ".item"

    const root = document.querySelector<HTMLElement>(rootSelector)
    if (!root) {
      teardown = () => {}
      return
    }

    const getCover = (idx: number): HTMLElement | null =>
      root.querySelector<HTMLElement>(
        `${coverSelector}[data-carousel-index="${idx}"]`,
      )

    const applyCover = (idx: number): void => {
      const total = root.querySelectorAll<HTMLElement>(
        `${coverSelector}[data-carousel-item]`,
      ).length
      const cover = getCover(idx)
      if (cover?.dataset.cover)
        cover.style.backgroundImage = `url(${cover.dataset.cover})`
      const next = getCover((idx + 1) % total)
      if (next?.dataset.cover)
        next.style.backgroundImage = `url(${next.dataset.cover})`
    }

    applyCover(0)

    teardown = setupCarousel(root, {
      interval: 5000,
      onChange: idx => applyCover(idx),
    })
  }

  mq.addEventListener("change", init)
  init()
</script>
