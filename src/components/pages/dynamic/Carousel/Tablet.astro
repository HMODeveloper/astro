---
interface Item {
  title: string
  description: string
  date: string
  cover: string
  path: string
}
interface Props {
  items: Item[]
}
const { items } = Astro.props
---

<div
  class="carousel-dynamic-tablet"
  data-carousel-dynamic-tablet
  data-carousel-pause
  data-responsive-tablet
>
  <div class="carousel">
    {
      items.map((item, i) => (
        <div
          class="item"
          data-carousel-item
          data-carousel-click
          data-carousel-index={i}
          data-cover={item.cover}
          data-active={i === 0 ? "" : undefined}
        >
          <div class="content">
            <div class="info">
              <div class="title">{item.title}</div>
              <div class="description">{item.description}</div>
              <div class="date">{item.date}</div>
            </div>
            <a
              class="button-container"
              href={`/dynamic/${item.path}`}
            >
              <span>
                <i class="fa-solid fa-arrow-right" />
              </span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
  <div class="line-container" data-carousel-pause>
    {
      [0, 1, 2, 3, 4].map(k => (
        <button
          type="button"
          class="line"
          data-carousel-item
          data-carousel-click
          data-carousel-index={k}
          data-active={k === 0 ? "" : undefined}
          aria-label={`跳转到第 ${k + 1} 项`}
        />
      ))
    }
  </div>
</div>

<style>
  .carousel-dynamic-tablet {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .item {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 2s ease;
    display: flex;
    align-items: flex-end;
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  .item[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  .item .content {
    width: 100%;
    padding: 0 var(--padding-y);
    background-color: var(--bg-cover);
    display: flex;
    align-items: center;
  }

  .item .content .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .item .title {
    font-size: var(--title-size);
    color: var(--text-light);
  }

  .item .description {
    font-size: var(--font-size);
  }

  .item .date {
    font-size: 0.75rem;
    color: var(--text-focus);
  }

  .button-container {
    width: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
  }

  .button-container span {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: var(--text-focus);
    text-align: center;
    color: var(--bg);
  }

  .line-container {
    width: 100%;
    display: flex;
    padding-top: 1rem;
    justify-content: center;
    gap: 0.5rem;
  }

  .line {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--text);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .line[data-active] {
    background: var(--text-light);
  }

  @media (max-width: 420px) {
    .line-container {
      padding-top: 0.5rem;
      gap: 0.25rem;
    }
  }
</style>

<script>
  import { setupCarousel } from "@/scripts/carousel"

  const root = document.querySelector<HTMLElement>("[data-carousel-dynamic-tablet]")!
  const items = Array.from(
    root.querySelectorAll<HTMLElement>("[data-carousel-item][data-cover]"),
  )
  const total = items.length

  function applyCover(idx: number): void {
    const cur = items[idx]
    if (cur?.dataset.cover && !cur.style.backgroundImage)
      cur.style.backgroundImage = `url(${cur.dataset.cover})`
    const next = items[(idx + 1) % total]
    if (next?.dataset.cover && !next.style.backgroundImage)
      next.style.backgroundImage = `url(${next.dataset.cover})`
  }

  applyCover(0)

  setupCarousel("[data-carousel-dynamic-tablet]", {
    interval: 5000,
    onChange: idx => applyCover(idx),
  })
</script>
