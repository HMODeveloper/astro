---
import { getCollection } from "astro:content"
import ImagePreloader from "@/components/base/ImagePreloader.astro"

const coverEntries = await getCollection("cover")
const coverList = coverEntries.map(c => c.data)
const serverEntries = await getCollection("server")
function titleOf(name: string) {
  return serverEntries.find(s => s.data.name === name)?.data.title ?? ""
}

const covers = coverList
  .map(item => ({
    url: item.url,
    title: titleOf(item.server),
    description: item.description,
  }))
  .sort(() => Math.random() - 0.5)
---

<div class="cover-carousel" data-carousel-cover-carousel>
  <div class="img-stack" data-carousel-pause>
    {
      covers.map((c, i) => (
        <div
          class="img"
          data-carousel-item
          data-carousel-index={i}
          data-cover-url={c.url}
          data-active={i === 0 ? "" : undefined}
        >
          <div class="img-content">
            {c.title} - {c.description}
          </div>
        </div>
      ))
    }
  </div>
  <div class="thumb-strip" data-carousel-pause>
    {
      [0, 1, 2, 3, 4].map(k => (
        <div
          class="thumb"
          data-carousel-click
          data-carousel-index={k}
          data-active={k === 2 ? "" : undefined}
        />
      ))
    }
  </div>

  <ImagePreloader data-next-cover />
</div>

<style>
  .cover-carousel {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .img-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .img {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 2s ease;
    display: flex;
    justify-content: center;
    align-items: end;
  }
  .img[data-active] {
    opacity: 1;
  }

  .img-content {
    width: 100%;
    background: var(--bg-cover);
    color: white;
    padding: var(--padding-y);
    box-sizing: border-box;
    font-size: var(--title-size);
    font-weight: bold;
  }

  .thumb-strip {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    background-image: none;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    background-color: rgba(0, 0, 0, 0.7);
    background-blend-mode: multiply;
    cursor: pointer;
    transition: background-image 0.5s ease;
  }
  .thumb[data-active] {
    background-color: transparent;
  }
</style>

<script>
  import { setupCarousel } from "@/scripts/carousel"

  const root = document.querySelector<HTMLElement>("[data-carousel-cover-carousel]")!
  const imgs = Array.from(
    root.querySelectorAll<HTMLElement>(".img[data-carousel-item]"),
  )
  const thumbs = Array.from(
    root.querySelectorAll<HTMLElement>(".thumb"),
  )
  const preloader = root.querySelector<HTMLImageElement>("img[data-next-cover]")
  const total = imgs.length

  function applyImg(idx: number): void {
    const img = imgs[idx]
    if (img?.dataset.coverUrl)
      img.style.backgroundImage = `url(${img.dataset.coverUrl})`
  }

  function updateStrip(idx: number) {
    if (total === 0)
      return
    for (let k = 0; k < 5; k++) {
      const off = k - 2
      const coverIdx = ((idx + off) % total + total) % total
      const url = imgs[coverIdx]?.dataset.coverUrl
      if (url)
        thumbs[k].style.backgroundImage = `url(${url})`
      thumbs[k].setAttribute("data-carousel-index", String(coverIdx))
      if (off === 0)
        thumbs[k].setAttribute("data-active", "")
      else
        thumbs[k].removeAttribute("data-active")
    }

    if (preloader) {
      const nextIdx = ((idx + 3) % total + total) % total
      const nextUrl = imgs[nextIdx]?.dataset.coverUrl
      if (nextUrl)
        preloader.src = nextUrl
    }
  }

  const initialActive = root.querySelector("[data-active][data-carousel-item]")
  const initialIdx = initialActive
    ? Number(initialActive.getAttribute("data-carousel-index"))
    : 0
  applyImg(initialIdx)
  updateStrip(initialIdx)

  setupCarousel("[data-carousel-cover-carousel]", {
    interval: 3000,
    onChange: (idx) => {
      applyImg(idx)
      updateStrip(idx)
    },
  })
</script>
