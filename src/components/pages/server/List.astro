---
import { getCollection } from "astro:content"
import Section from "@/components/base/Section.astro"

interface ServerCard {
  index: number
  title: string
  intro: string
  description: string
  start: string
  end: string | null
  cover: string
  path: string
}

const entries = await getCollection("server")
const items: ServerCard[] = entries
  .map(entry => ({
    index: entry.data.index,
    title: entry.data.title,
    intro: entry.data.intro,
    description: entry.data.description,
    start: entry.data.start,
    end: entry.data.end ?? null,
    cover: entry.data.cover,
    path: entry.id,
  }))
  .sort((a, b) => {
    const aClosed = a.end != null
    const bClosed = b.end != null
    if (aClosed !== bClosed)
      return aClosed ? 1 : -1
    return a.index - b.index
  })
---

<Section classname="list-section">
  <Fragment slot="title">服务器列表</Fragment>
  <div class="list">
    {
      items.map(item => (
        <div class="item-container" data-section>
          <a
            class="item"
            data-scroll
            href={`/server/${item.path}`}
          >
            <img
              class="cover"
              src=""
              alt={item.title}
              data-img-src={item.cover}
            />
            <div class="content">
              <div class="item-title">
                <span class="title-text">{item.title}</span>
                {item.end && <span class="closed-pill">已完结</span>}
              </div>
              <div class="intro">{item.description || item.intro}</div>
              <div class="date">
                <div class="date-line">
                  开服日期: {item.start || "--已不可考--"}
                  {item.start && (
                    <span
                      data-server-days
                      data-start={item.start}
                      data-end={item.end ?? ""}
                    > -- </span>
                  )}
                </div>
                {item.end && (
                  <div class="date-line">完结日期: {item.end}</div>
                )}
              </div>
            </div>
          </a>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .list-section {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .list {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--padding-y);
    margin: var(--padding-y) 0;
    overflow-x: hidden;
    width: 100%;
  }

  .item-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: var(--padding-y) var(--padding-y);
  }

  .item {
    width: 100%;
    display: flex;
    gap: var(--padding-y);
    text-decoration: none;
    color: var(--text);
    transform: translateX(50%);
    opacity: 0;
    transition: all 0.5s ease;
  }
  .item.scrolled {
    transform: translateX(0%);
    opacity: 1;
  }

  .cover {
    height: 10rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
  }

  .content {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .item-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--title-size);
    color: var(--text-light);
  }

  .closed-pill {
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-decoration);
    color: var(--bg);
    font-size: calc(var(--font-size) * 0.85);
    font-weight: bold;
    white-space: nowrap;
  }

  .intro {
    flex: 1;
    display: block;
    font-size: var(--font-size);
  }

  .date {
    font-size: var(--font-size);
    color: var(--text-focus);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .item:hover .title-text {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .cover {
      height: 8rem;
    }
  }

  @media (max-width: 640px) {
    .cover {
      height: 6rem;
    }
  }

  @media (max-width: 420px) {
    .item {
      flex-direction: column;
      width: 100%;
      height: auto;
    }
    .cover {
      width: 100%;
      height: auto;
    }
  }
</style>

<script>
const AHEAD = 2

function applyImg(el: HTMLElement, depth = 0): void {
  if (depth > AHEAD)
    return
  const img = el.querySelector<HTMLImageElement>("img[data-img-src]")
  if (img?.dataset.imgSrc && !img.getAttribute("src"))
    img.src = img.dataset.imgSrc
  const nextItem = el.parentElement?.nextElementSibling?.querySelector<HTMLElement>(".item[data-scroll]")
  if (nextItem)
    applyImg(nextItem, depth + 1)
}

const observer = new MutationObserver((mutations) => {
  for (const m of mutations) {
    if (m.attributeName !== "class")
      continue
    const el = m.target as HTMLElement
    if (el.classList.contains("scrolled"))
      applyImg(el)
  }
})
for (const el of document.querySelectorAll<HTMLElement>(".item[data-scroll]"))
  observer.observe(el, { attributes: true })

function daysBetween(from: string, to?: string): number {
  const f = new Date(`${from}T00:00:00Z`)
  const t = to ? new Date(`${to}T00:00:00Z`) : new Date()
  return Math.max(0, Math.floor((t.getTime() - f.getTime()) / 86_400_000))
}

for (const el of document.querySelectorAll<HTMLElement>("[data-server-days]")) {
  const start = el.dataset.start
  const end = el.dataset.end
  if (!start)
    continue
  el.textContent = end
    ? `(开服 ${daysBetween(start, end)} 天, 已完结 ${daysBetween(end)} 天)`
    : `(已开服 ${daysBetween(start)} 天)`
}
</script>
