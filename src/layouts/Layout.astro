---
import { getCollection } from "astro:content"
import Background from "@/components/common/Background.astro"
import Footer from "@/components/common/Footer.astro"
import Navbar from "@/components/common/Navbar/index.astro"
import "@/styles/main.css"

interface Props {
  title?: string
  description?: string
}

const [site] = await getCollection("site")

const {
  title = site.data.title,
  description = site.data.description,
} = Astro.props
const pathname = Astro.url.pathname
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      crossorigin="anonymous"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="app">
      <Background />
      <div class="container">
        <Navbar pathname={pathname} />
        <div class="content">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
    <script>
      import { loadLazyImages } from "@/scripts/lazy-image"
      import { setupScrollClass } from "@/scripts/scroll-observer"

      setupScrollClass()
      loadLazyImages()
    </script>
  </body>
</html>

<style>
  .app {
    position: relative;
    width: 100%;
    min-height: 100vh;
    color: var(--text);
  }
  .container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 100;
  }
  .content {
    flex: 1;
    position: relative;
    width: var(--max-width);
    padding-top: var(--padding-y);
  }
</style>
