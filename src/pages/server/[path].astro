---
import { getCollection } from "astro:content"
import Section from "@/components/base/Section.astro"
import Markdown from "@/components/markdown/index.astro"
import Layout from "@/layouts/Layout.astro"

export async function getStaticPaths() {
  const all = await getCollection("server")
  return all.map(entry => ({
    params: { path: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
---

<Layout>
  <div class="page">
    <Section classname="nav-container">
      <Fragment slot="title">
        <a
          href="/server"
          class="nav"
        >
          <i class="fa-solid fa-arrow-left" />
          返回主页
        </a>
      </Fragment>
    </Section>

    <img
      class="cover"
      src={entry.data.cover}
      alt="cover"
    />

    <div class="title">
      <i class="fa-solid fa-play" />
      {entry.data.title}
    </div>

    <div class="info">
      <span class="date">
        开服日期:
        <i class="fa-solid fa-calendar" />
        <span>{entry.data.start || "xxxx-xx-xx"}</span>
      </span>
      {
        entry.data.map && (
          <span class="map">
            网页地图:
            <i class="fa-solid fa-earth-americas" />
            <a
              href={`https://${entry.data.map}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {entry.data.map}
            </a>
          </span>
        )
      }
      {
        entry.data.name !== "join" && (
          <span class="join">
            入服指南:
            <i class="fa-solid fa-book" />
            <a
              href="https://docs.qq.com/aio/p/scw3wwi5x2tslm9?p=homViskRsqkXC8nDU2h6HY"
              target="_blank"
              rel="noopener noreferrer"
            >
              点击查看
            </a>
          </span>
        )
      }
    </div>

    <Markdown entry={entry} />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 var(--padding-x) var(--padding-y);
  }

  .nav {
    width: 100%;
    margin-bottom: 1rem;
    color: var(--text-light);
    text-decoration: none;
    font-size: var(--title-size);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav i {
    transition: transform 0.3s ease;
  }
  .nav:hover i {
    transform: translateX(-2px);
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
  }

  .title {
    font-size: calc(var(--title-size) * 1.5);
    font-weight: bold;
    color: var(--text-light);
  }
  .title i {
    font-size: calc(var(--title-size) * 1.5);
  }

  .info {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: start;
  }
  .info span {
    font-size: var(--font-size);
    color: var(--text-light);
  }
  .info a {
    color: var(--text-light);
    text-decoration: underline;
  }
  .info a:hover {
    color: var(--text-focus);
  }

  @media (max-width: 768px) {
    .info {
      flex-direction: column;
      align-items: flex-start;
    }
    .info span {
      width: 100%;
    }
  }
</style>
