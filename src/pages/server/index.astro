---
import Section from "@/components/base/Section.astro"
import Carousel from "@/components/pages/server/Carousel.astro"
import List from "@/components/pages/server/List.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <div class="page">
    <Section classname="title-container">
      <Fragment slot="title">服务器信息</Fragment>
    </Section>
    <Carousel />
    <List />
  </div>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 var(--padding-x) var(--padding-y);
  }

  .title-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
</style>
